FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /source
COPY src/SupportTicketManager.Core/SupportTicketManager.Core.csproj src/SupportTicketManager.Core/
COPY src/SupportTicketManager.Api/SupportTicketManager.Api.csproj src/SupportTicketManager.Api/
RUN dotnet restore src/SupportTicketManager.Api/SupportTicketManager.Api.csproj
COPY src/ src/
RUN dotnet publish src/SupportTicketManager.Api/SupportTicketManager.Api.csproj -c Release --no-restore -o /out /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates util-linux && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=1654:1654 /out/ ./
COPY deploy/api-entrypoint.sh /entrypoint.sh
RUN chmod 755 /entrypoint.sh && mkdir -p /var/lib/tsm-keys && chown 1654:1654 /var/lib/tsm-keys
ENV ASPNETCORE_URLS=http://+:8080 ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]
